package com.kodewala.objectCreation;

public class User 
{
	String userName;
	String userId;
	String mobileNumber;
	
	static
	{
		System.out.println("I am in static init block");
	}
	
	public User(String _userName, String _userId, String _mobileNumber) {
		super();
		this.userName = _userName;
		this.userId = _userId;
		this.mobileNumber = _mobileNumber;
	}
}
