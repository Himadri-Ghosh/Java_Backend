package com.practice.constructors1;

public class Company {

	public static void main(String args[]) {
		
		int age = Integer.parseInt(args[1]);
		int salary = Integer.parseInt(args[2]);
		
		Employee employee1 = new Employee(args[0], age, salary, args[2]);
		
		System.out.println("Employee Name : " + employee1.employeeName);
		System.out.println("Age : " + employee1.age);
		System.out.println("Salary : " + employee1.salary);
		System.out.println("Address : " + employee1.address);
		
	}
	
}
