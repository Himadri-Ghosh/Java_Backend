package com.practice.oops.encapsulation1;

public class Employee 
{
	private String name;
	private double salary;
	
	Employee(String name, double salary)
	{
		this.name = name;
		
		if(salary >= 0)
		{
			this.salary = salary;
		}
	}
	
	public void increaseSalary(int amount)
	{
		if(amount > 0)
		{
			salary += amount;
		}
		else
		{
			System.out.println("Insufficient Balance");
		}
	}
}
