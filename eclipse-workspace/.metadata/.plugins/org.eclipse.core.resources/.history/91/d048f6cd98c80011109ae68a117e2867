package com.practice.oops.inheritance.bank;

public class CurrentAccount 
{
	String accountType;
	String accountNumber;
	private double balance;
	
	public CurrentAccount(String accountHolderName, String accountHolderAddress, String bankName, String accountType, String accountNumber, double balance) {
		super(accountHolderName, accountHolderAddress, bankName);
		this.accountType = accountType;
		this.accountNumber = accountNumber;
		this.balance = balance;
	}
	
	
}
