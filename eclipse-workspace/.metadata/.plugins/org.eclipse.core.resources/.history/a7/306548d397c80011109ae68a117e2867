package com.practice.oops.inheritance.bank;

public class SavingsAccount extends AccountDetails
{
	String accountType;
	String accountNumber;
	double balance;
	
	public SavingsAccount(String accountHolderName, String accountHolderAddress, String bankName, String accountType, String accountNumber, double balance) 
	{
		super(accountHolderName, accountHolderAddress, bankName);
		this.accountType = accountType;
		this.accountNumber = accountNumber;
		this.balance = balance;
	}
}
