package com.practice.oops.encapsulation1;

public class Mobile 
{
	private int volume;
	
	public int getVolume()
	{
		return volume;
	}
	
	public void setVolume(int volume)
	{
		if(volume >= 0 && volume <=100)
		{
			this.volume = volume;
		}
		else
		{
			System.out.println("Volume must be between 0 to 100");
		}
	}
	
	public void increaseVolume()
	{
		if(volume < 100)
		{
			volume ++;
		}
	}
	public void increaseVolume()
	{
		if(volume < 100)
		{
			volume++;
		}
	}
	
	public void decreaseVolume()
	{
		if(volume > 0)
		{
			volume--;
		}
	}
}
